{
  "name": "create-sia-app",
  "version": "0.1.19",
  "description": "Scaffold a private, encrypted storage app on the Sia network.",
  "homepage": "https://github.com/SiaFoundation/create-sia-app#readme",
  "bugs": {
    "url": "https://github.com/SiaFoundation/create-sia-app/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SiaFoundation/create-sia-app.git"
  },
  "bin": {
    "create-sia-app": "./dist/index.js"
  },
  "files": [
    "dist/",
    "template/"
  ],
  "type": "module",
  "scripts": {
    "build": "bun build.ts",
    "dev": "bun build src/index.ts --target node --format esm --packages external --outdir dist --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./test"
  },
  "dependencies": {
    "@clack/prompts": "1.8.0",
    "picocolors": "1.1.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "22.20.2",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
