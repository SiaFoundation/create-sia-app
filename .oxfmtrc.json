{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 80,
  "sortImports": true,
  "ignorePatterns": [
    "template/**",
    "packages/create-sia-app/template/**",
    "packages/create-sia-app/dist/**",
    "CHANGELOG.md",
    ".changeset/**"
  ]
}
